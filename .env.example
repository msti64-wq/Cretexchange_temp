# CreteXchange deployment environment template.
# Replace every placeholder before deploying. Do not commit real secrets.

# Core runtime
NODE_ENV=production
PORT=5000
# Local testing: HOST=127.0.0.1
# Cloud/container deployment if needed: HOST=0.0.0.0
HOST=127.0.0.1
DATABASE_URL=postgresql://user:password@host:5432/database
BASE_URL=https://your-production-domain.example

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-a-separate-long-random-session-secret

# Stripe
STRIPE_SECRET_KEY=sk_live_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PLATFORM_FINANCIAL_ACCOUNT_ID=fa_placeholder
VITE_STRIPE_PUBLIC_KEY=pk_live_placeholder

# Object storage
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_BUCKET_NAME=your-gcs-bucket-name
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-object-storage-bucket-name
PRIVATE_OBJECT_DIR=/your-object-storage-bucket-name/private
PUBLIC_OBJECT_SEARCH_PATHS=/your-object-storage-bucket-name/public,/your-object-storage-bucket-name/uploads

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Column banking and wallet flows
COLUMN_API_KEY=your-column-api-key
COLUMN_PLATFORM_ENTITY_ID=your-column-platform-entity-id
COLUMN_PLATFORM_ACCOUNT_ID=your-column-platform-account-id
COLUMN_PLATFORM_ACCOUNT_NUMBER=your-column-platform-account-number
COLUMN_PLATFORM_ROUTING=your-column-platform-routing-number

# Lithic card issuing flows
LITHIC_API_KEY=your-lithic-api-key
LITHIC_BASE_URL=https://api.lithic.com/v1
LITHIC_CARD_PROGRAM_TOKEN=your-lithic-card-program-token
LITHIC_PRODUCT_ID=your-lithic-product-id
